BOT_TOKEN=123456789:AAExampleTokenReplaceMe
ADMIN_IDS=

STORAGE_DIR=storage
RETENTION_HOURS=3
CLEANUP_INTERVAL_SECONDS=300

MAX_CONCURRENT_DOWNLOADS=2
MAX_UPLOAD_MB=49
MAX_URLS_PER_MESSAGE=5
USER_COOLDOWN_SECONDS=5
MAX_VIDEO_DURATION_SECONDS=3600
MAX_PLAYLIST_ITEMS=25

# إزالة اسم المستخدم المطبوع داخل الفيديو
REMOVE_USERNAME=true
USERNAME_OCR_FRAMES=10
USERNAME_MAX_SECONDS=600
USERNAME_OCR_WIDTH=1280
USERNAME_OCR_MIN_SCORE=0.25
# إزالة أي يوزر مكتوب بصيغة @name حتى لو لم يكن صاحب المحتوى
USERNAME_ANY_MENTION=false
# عتبة خطورة التشويه (0.60): عند تجاوزها يسألك البوت عن نص بديل
USERNAME_RISK_THRESHOLD=0.45
# اقتراح /fix عند عدم العثور على الاسم
USERNAME_OFFER_MANUAL=true
# خط بديل اختياري
# USERNAME_FONT_FILE=

# المنصات المفعّلة (للسرعة) — فارغ = كل المنصات
ALLOWED_PLATFORMS=tiktok,instagram,facebook

# COOKIES_FILE=cookies.txt
# COOKIES_B64=
# PROXY_URL=

LOG_LEVEL=INFO
